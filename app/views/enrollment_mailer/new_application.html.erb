<h2>Yeni <%= @enrollment.discipline.name %> Başvurusu</h2>

<p>Web sitesi üzerinden yeni bir <%= @enrollment.discipline.name %> başvurusu alındı:</p>

<table cellpadding="6" cellspacing="0" border="0">
  <tr>
    <td><strong>Ad Soyad</strong></td>
    <td><%= @enrollment.full_name %></td>
  </tr>
  <tr>
    <td><strong>Branş</strong></td>
    <td><%= @enrollment.discipline.name %></td>
  </tr>
  <tr>
    <td><strong>Telefon</strong></td>
    <td><a href="tel:<%= @enrollment.phone %>"><%= @enrollment.phone %></a></td>
  </tr>
  <% if @enrollment.email.present? %>
    <tr>
      <td><strong>E-posta</strong></td>
      <td><a href="mailto:<%= @enrollment.email %>"><%= @enrollment.email %></a></td>
    </tr>
  <% end %>
  <tr>
    <td><strong>Yaş</strong></td>
    <td><%= @enrollment.age %></td>
  </tr>
  <tr>
    <td><strong>Seviye</strong></td>
    <td><%= Enrollment.enum_label(:levels, @enrollment.level) %></td>
  </tr>
  <% if @enrollment.message.present? %>
    <tr>
      <td><strong>Mesaj</strong></td>
      <td><%= @enrollment.message %></td>
    </tr>
  <% end %>
  <tr>
    <td><strong>Başvuru Tarihi</strong></td>
    <td><%= I18n.l(@enrollment.created_at, format: "%d %B %Y, %H:%M") %></td>
  </tr>
</table>

<p>
  Tüm başvuruları yönetim panelinden takip edebilirsiniz:
  <%= link_to "Başvurular", admin_enrollments_url %>
</p>
