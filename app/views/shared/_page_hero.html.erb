<%
#  Renders a hero section with a background image and title.
#  Required locals:
#  - title: The title text to display in the hero section.
#  - image: The URL/path of the background image.
#  Optional locals:
#  - alt_text: Alt text for the background image (defaults to title).
#  - aria_label: ARIA label for the section (defaults to "#{title} Hero").
#  Usage:
#  render "shared/page_hero", title: "Page Title", image: "path/to/image.jpg", alt_text: "Alt Text"
%>

<% 
  aria_label = local_assigns.fetch(:aria_label, "#{title} Hero")
  alt_text = local_assigns.fetch(:alt_text, title)
%>

<%# Mobile Hero - compact title bar %>
<section class="md:hidden bg-neutral-950 py-8 sm:py-10" aria-label="<%= aria_label %>">
  <div class="container mx-auto px-4 sm:px-6">
    <p class="font-display text-2xl sm:text-3xl font-black text-white mb-3 leading-[0.95]">
      <%= title %>
    </p>
    <div class="relative w-full max-w-xs">
      <div class="h-[2px] w-full bg-gradient-to-r from-primary via-primary/70 to-transparent"></div>
      <div class="absolute -left-1 top-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-primary rotate-45"></div>
    </div>
  </div>
</section>

<%# Desktop Hero - full visual %>
<section class="relative min-h-[60svh] sm:min-h-[70svh] overflow-hidden bg-neutral-950 hidden md:block" aria-label="<%= aria_label %>">
  <%# Background %>
  <div class="absolute inset-0">
    <%= image_tag image, alt: alt_text, class: 'w-full h-full object-cover object-center', loading: 'eager' %>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-neutral-950/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950/80 via-transparent to-neutral-950/80"></div>
  </div>

  <%# Content %>
  <div class="relative z-10 min-h-[60svh] sm:min-h-[70svh] font-display flex flex-col justify-end container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">

    <%# Title %>
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-black text-white mb-4 sm:mb-6 leading-[0.95]">
      <span class="block"><%= title %></span>
    </h1>

    <%# Decorative line %>
    <div class="relative w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg">
      <div class="h-[2px] sm:h-[3px] w-full bg-gradient-to-r from-primary via-primary/70 to-transparent"></div>
      <div class="absolute -left-1 top-1/2 -translate-y-1/2 w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rotate-45"></div>
    </div>
  </div>
</section>
