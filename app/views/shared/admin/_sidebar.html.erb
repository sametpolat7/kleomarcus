<aside data-controller="sidebar" class="group/sidebar w-64 data-[collapsed=true]:w-16 min-h-screen bg-base-100 border-r border-base-300 flex flex-col overflow-x-clip transition-[width] duration-200 ease-out">

  <div class="flex items-center justify-between group-data-[collapsed=true]/sidebar:justify-center gap-2 px-5 group-data-[collapsed=true]/sidebar:px-2 py-4 border-b border-base-300">
    <%= link_to admin_root_path, class: "block min-w-0", "aria-label": "Kleomarcus", data: { action: "click->sidebar#brand" } do %>
      <span class="hidden group-data-[collapsed=true]/sidebar:inline-flex items-center justify-center w-8 h-8 rounded-md bg-primary/10 text-primary">
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </span>
      <span class="block group-data-[collapsed=true]/sidebar:hidden font-display text-base font-bold tracking-[0.2em] text-primary truncate">KLEOMARCUS</span>
      <span class="block group-data-[collapsed=true]/sidebar:hidden mt-0.5 text-[10px] text-base-content/50 tracking-widest uppercase">Yönetim Paneli</span>
    <% end %>
    <button type="button" data-action="click->sidebar#toggle" class="btn btn-ghost btn-xs btn-square shrink-0 cursor-pointer hidden lg:inline-flex lg:group-data-[collapsed=true]/sidebar:hidden" aria-label="Menüyü daralt">
      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
  </div>

  <nav class="flex-1 px-3 py-3 flex flex-col gap-1 overflow-y-auto">
    <p class="px-4 pt-4 pb-1 text-[10px] font-semibold tracking-widest uppercase text-base-content/40 group-data-[collapsed=true]/sidebar:hidden">Ana</p>

    <%= link_to admin_root_path, class: ["flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm transition-colors text-base-content/70 hover:bg-base-200 hover:text-base-content group-data-[collapsed=true]/sidebar:justify-center group-data-[collapsed=true]/sidebar:gap-0 group-data-[collapsed=true]/sidebar:px-2", ("bg-primary/10 text-primary font-semibold hover:bg-primary/15 hover:text-primary" if controller_path.start_with?("admin/dashboard"))], title: "Dashboard", "aria-current": (controller_path.start_with?("admin/dashboard") ? "page" : nil) do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="truncate group-data-[collapsed=true]/sidebar:hidden">Dashboard</span>
    <% end %>

    <div class="my-1 border-t border-base-300/60" aria-hidden="true"></div>
    <p class="px-4 pt-4 pb-1 text-[10px] font-semibold tracking-widest uppercase text-base-content/40 group-data-[collapsed=true]/sidebar:hidden">İçerik</p>

    <%= link_to admin_trainers_path, class: ["flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm transition-colors text-base-content/70 hover:bg-base-200 hover:text-base-content group-data-[collapsed=true]/sidebar:justify-center group-data-[collapsed=true]/sidebar:gap-0 group-data-[collapsed=true]/sidebar:px-2", ("bg-primary/10 text-primary font-semibold hover:bg-primary/15 hover:text-primary" if controller_path.start_with?("admin/trainers"))], title: "Eğitmenler", "aria-current": (controller_path.start_with?("admin/trainers") ? "page" : nil) do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
      </svg>
      <span class="truncate group-data-[collapsed=true]/sidebar:hidden">Eğitmenler</span>
    <% end %>

    <%= link_to admin_lessons_path, class: ["flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm transition-colors text-base-content/70 hover:bg-base-200 hover:text-base-content group-data-[collapsed=true]/sidebar:justify-center group-data-[collapsed=true]/sidebar:gap-0 group-data-[collapsed=true]/sidebar:px-2", ("bg-primary/10 text-primary font-semibold hover:bg-primary/15 hover:text-primary" if controller_path.start_with?("admin/lessons"))], title: "Dersler", "aria-current": (controller_path.start_with?("admin/lessons") ? "page" : nil) do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <span class="truncate group-data-[collapsed=true]/sidebar:hidden">Dersler</span>
    <% end %>

    <%= link_to admin_testimonials_path, class: ["flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm transition-colors text-base-content/70 hover:bg-base-200 hover:text-base-content group-data-[collapsed=true]/sidebar:justify-center group-data-[collapsed=true]/sidebar:gap-0 group-data-[collapsed=true]/sidebar:px-2", ("bg-primary/10 text-primary font-semibold hover:bg-primary/15 hover:text-primary" if controller_path.start_with?("admin/testimonials"))], title: "Yorumlar", "aria-current": (controller_path.start_with?("admin/testimonials") ? "page" : nil) do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
      </svg>
      <span class="truncate group-data-[collapsed=true]/sidebar:hidden">Yorumlar</span>
    <% end %>

    <div class="my-1 border-t border-base-300/60" aria-hidden="true"></div>
    <p class="px-4 pt-4 pb-1 text-[10px] font-semibold tracking-widest uppercase text-base-content/40 group-data-[collapsed=true]/sidebar:hidden">Sistem</p>

    <%= link_to admin_users_path, class: ["flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm transition-colors text-base-content/70 hover:bg-base-200 hover:text-base-content group-data-[collapsed=true]/sidebar:justify-center group-data-[collapsed=true]/sidebar:gap-0 group-data-[collapsed=true]/sidebar:px-2", ("bg-primary/10 text-primary font-semibold hover:bg-primary/15 hover:text-primary" if controller_path.start_with?("admin/users"))], title: "Kullanıcılar", "aria-current": (controller_path.start_with?("admin/users") ? "page" : nil) do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="truncate group-data-[collapsed=true]/sidebar:hidden">Kullanıcılar</span>
    <% end %>
  </nav>

  <div class="px-5 py-3 border-t border-base-300 text-[10px] text-base-content/40 tracking-wider uppercase group-data-[collapsed=true]/sidebar:hidden">
    &copy; <%= Date.current.year %> Kleomarcus
  </div>
</aside>
