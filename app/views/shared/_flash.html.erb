<%
  flash_styles = {
    notice: { stripe: "border-l-success", bg: "bg-success/10", bar: "bg-success", icon_color: "text-success", icon: "M5 13l4 4L19 7" },
    alert:  { stripe: "border-l-error",   bg: "bg-error/10",   bar: "bg-error",   icon_color: "text-error",   icon: "M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z" }
  }
%>
<% if flash.any? %>
  <div class="fixed top-4 right-4 z-50 flex flex-col gap-2 w-96 max-w-[calc(100vw-2rem)]">
    <% flash.each do |type, message| %>
      <% style = flash_styles[type.to_sym] || { stripe: "border-l-info", bg: "bg-info/10", bar: "bg-info", icon_color: "text-info", icon: "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" } %>
      <div role="alert" data-controller="flash" class="relative flex items-center gap-3 py-3.5 px-4 rounded-md shadow-sm bg-base-100 border border-base-300 border-l-4 <%= style[:stripe] %> <%= style[:bg] %> overflow-hidden transition-all duration-200 ease-out">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0 <%= style[:icon_color] %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= style[:icon] %>" />
        </svg>
        <span class="flex-1 text-[13px] font-medium leading-snug text-base-content"><%= message %></span>
        <span data-flash-target="bar" class="absolute bottom-0 left-0 h-0.5 w-full <%= style[:bar] %>/70" aria-hidden="true"></span>
      </div>
    <% end %>
  </div>
<% end %>
