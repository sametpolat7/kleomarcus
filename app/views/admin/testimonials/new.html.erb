<% content_for :title, "Yeni Yorum · Kleomarcus Admin" %>

<div class="admin-card max-w-3xl mx-auto">
  <%= turbo_frame_tag "admin_modal_frame" do %>
    <%= admin_modal_header "Yeni Yorum",
          subtitle: "Yeni bir müşteri yorumu ekleyin.",
          cancel_path: admin_testimonials_path %>
    <div class="p-6">
      <%= render "admin/testimonials/form", testimonial: @testimonial %>
    </div>
  <% end %>
</div>
