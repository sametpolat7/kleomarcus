<% content_for :title, "Antrenör Düzenle · Kleomarcus Admin" %>

<div class="admin-card max-w-3xl mx-auto">
  <%= turbo_frame_tag "admin_modal_frame" do %>
    <%= admin_modal_header "Antrenör Düzenle",
          subtitle: @trainer.name,
          cancel_path: admin_trainers_path %>
    <div class="p-6">
      <%= render "admin/trainers/form", trainer: @trainer %>
    </div>
  <% end %>
</div>
