<%# locals: (row:) %>
<tr class="hover:bg-base-200/40 transition-colors">
  <td class="text-base-content/60 w-12"><%= row.position %></td>
  <td>
    <div class="flex items-center gap-3">
      <% if row.photo.attached? %>
        <%= image_tag row.photo, alt: "Trainer Profile Photo", class: "w-10 h-10 rounded-full object-cover border border-base-300" %>
      <% else %>
        <div class="w-10 h-10 rounded-full bg-base-200 flex items-center justify-center text-xs font-semibold text-base-content/50">
          <%= row.name.to_s.chars.first&.upcase %>
        </div>
      <% end %>
      <span class="font-medium"><%= row.name %></span>
    </div>
  </td>
  <td class="text-base-content/70"><%= row.title %></td>
  <td>
    <div class="flex flex-wrap gap-1">
      <% row.disciplines.each do |d| %>
        <%= badge(d.name, variant: :ghost) %>
      <% end %>
      <% if row.disciplines.empty? %>
        <span class="text-xs text-base-content/40">—</span>
      <% end %>
    </div>
  </td>

  <td class="text-right">
    <div class="inline-flex gap-1">
      <%= modal_trigger "Düzenle", edit_admin_trainer_path(row), variant: :ghost %>
      <%= button_to "Sil", admin_trainer_path(row),
            method: :delete,
            class: "btn btn-sm btn-ghost text-error",
            form: { data: { turbo_confirm: "“#{row.name}” antrenörünü silmek istediğinize emin misiniz?" } } %>
    </div>
  </td>
</tr>
