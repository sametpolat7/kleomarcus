<% content_for :title, "Geri Bildirimler · Kleomarcus Admin" %>

<%= admin_page_header "Geri Bildirimler", subtitle: "Ziyaretçilerin isim belirtmeden gönderdiği değerlendirmeler." do %>
  <%= link_to admin_feedbacks_poster_path, target: "_blank", rel: "noopener", class: "btn btn-sm btn-outline gap-2" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
    </svg>
    QR Afişi
  <% end %>
<% end %>

<div class="flex flex-wrap items-center gap-2 mb-4">
  <%= link_to "Tümü", admin_feedbacks_path, class: "btn btn-sm #{@topic.nil? ? "btn-primary" : "btn-ghost"}" %>

  <% Feedback.topics.each_key do |topic| %>
    <%= link_to Feedback.enum_label(:topic, topic),
          admin_feedbacks_path(topic: topic), class: "btn btn-sm #{@topic == topic ? "btn-primary" : "btn-ghost"}" %>
  <% end %>
</div>

<%= render "shared/admin/table",
      columns: ["Konu", "Mesaj", "Tarih"],
      rows: @feedbacks,
      row_partial: "admin/feedbacks/row",
      pagy: @pagy,
      empty_text: "Henüz geri bildirim yok.",
      actions: false %>
