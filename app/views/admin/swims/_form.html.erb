<%= render "shared/admin/form_errors", resource: swim %>

<dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 mb-6">
  <div>
    <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Ad Soyad</dt>
    <dd class="mt-1 text-sm text-base-content"><%= swim.full_name %></dd>
  </div>

  <div>
    <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Yaş</dt>
    <dd class="mt-1 text-sm text-base-content"><%= swim.age %></dd>
  </div>

  <div>
    <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Telefon</dt>
    <dd class="mt-1 text-sm"><a href="tel:<%= swim.phone %>" class="link link-hover text-primary"><%= format_phone(swim.phone) %></a></dd>
  </div>

  <div>
    <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50">E-posta</dt>
    <dd class="mt-1 text-sm">
      <% if swim.email.present? %>
        <a href="mailto:<%= swim.email %>" class="link link-hover text-primary"><%= swim.email %></a>
      <% else %>
        <span class="text-base-content/40">—</span>
      <% end %>
    </dd>
  </div>

  <div>
    <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Yüzme Seviyesi</dt>
    <dd class="mt-1"><%= swim_level_label(swim) %></dd>
  </div>

  <div>
    <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Başvuru Tarihi</dt>
    <dd class="mt-1 text-sm text-base-content"><%= format_date(swim.created_at) %></dd>
  </div>

  <div>
    <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50">KVKK Onayı</dt>
    <dd class="mt-1 text-sm text-base-content"><%= format_date(swim.kvkk_accepted_at) %></dd>
  </div>

  <% if swim.message.present? %>
    <div class="sm:col-span-2">
      <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/50">Mesaj</dt>
      <dd class="mt-1 text-sm text-base-content/80 leading-relaxed whitespace-pre-line"><%= swim.message %></dd>
    </div>
  <% end %>
</dl>

<%= form_with model: [:admin, swim] do |f| %>
  <div>
    <label class="admin-form-label" for="swim_status">Durum</label>
    <%= f.select :status,
          Swim.statuses.keys.map { |k| [ Swim.enum_label(:statuses, k), k ] },
          {},
          { id: "swim_status", class: "select select-bordered w-full" } %>
  </div>

  <div class="flex items-center justify-end gap-2 pt-3 mt-6 border-t border-base-300">
    <%= link_to "İptal", admin_swims_path,
          class: "btn btn-ghost",
          data: { action: "click->modal#close" } %>
    <%= f.submit "Güncelle", class: "btn btn-primary" %>
  </div>
<% end %>
