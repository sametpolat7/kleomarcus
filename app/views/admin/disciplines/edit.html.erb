<% content_for :title, "Branş Düzenle · Kleomarcus Admin" %>

<div class="admin-card max-w-3xl mx-auto">
  <%= turbo_frame_tag "admin_modal_frame" do %>
    <%= admin_modal_header "Branş Düzenle",
          subtitle: @discipline.name_in_database,
          cancel_path: admin_disciplines_path %>
    <div class="p-6">
      <%= render "admin/disciplines/form", discipline: @discipline %>
    </div>
  <% end %>
</div>
