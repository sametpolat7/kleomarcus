<div class="min-h-screen flex items-center justify-center px-4 bg-slate-100">
  <div class="w-full max-w-md">

    <%# Brand %>
    <div class="text-center mb-8">
      <span class="font-display text-2xl sm:text-3xl font-bold text-slate-900 tracking-[0.25em]">
        KLEOMARCUS
      </span>
      <p class="mt-1.5 text-xs text-slate-400 tracking-widest uppercase">
        Yönetim Paneli
      </p>
    </div>

    <%# Card %>
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200">
      <div class="px-6 py-8 sm:px-10 sm:py-10">
        <h1 class="text-xs font-semibold text-slate-400 tracking-widest uppercase mb-8">
          Hesabınıza Giriş Yapın
        </h1>

        <% if alert = flash[:alert] %>
          <div role="alert" class="flex items-center gap-2 mb-6 px-3 py-2.5 rounded-lg bg-red-50 border border-red-200 text-sm text-red-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.538-1.333-3.308 0L3.732 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span><%= alert %></span>
          </div>
        <% end %>

        <%= form_with url: admin_session_path, class: "flex flex-col gap-5" do |form| %>
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-semibold text-slate-600 tracking-wide">E-posta Adresi</label>
            <%= form.email_field :email_address,
                  required: true,
                  placeholder: "Lütfen e-posta adresinizi girin",
                  value: params[:email_address],
                  class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-sm bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-500/15 transition" %>
          </div>

          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-semibold text-slate-600 tracking-wide">Şifre</label>
            <%= form.password_field :password,
                  required: true,
                  placeholder: "Lütfen şifrenizi girin",
                  maxlength: 72,
                  class: "w-full border border-slate-300 rounded-lg px-4 py-3 text-sm bg-white text-slate-900 placeholder-slate-400 focus:outline-none focus:border-slate-500 focus:ring-2 focus:ring-slate-500/15 transition" %>
          </div>

          <%= form.submit "Giriş Yap", class: "w-full mt-3 py-3 bg-slate-900 hover:bg-slate-700 text-white font-semibold text-sm rounded-lg cursor-pointer transition-colors duration-200" %>
        <% end %>
      </div>
    </div>

    <p class="mt-6 text-center text-xs text-slate-400">
      &copy; <%= Date.current.year %> Kleomarcus Spor Akademi
    </p>
  </div>
</div>
