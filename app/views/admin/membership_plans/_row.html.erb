<%# locals: (row:) %>
<tr class="hover:bg-base-200/40 transition-colors">
  <td class="font-medium whitespace-nowrap">
    <%= row.name %>
    <%= badge("Popüler", variant: :primary) if row.featured? %>
  </td>
  <td class="text-base-content/70">
    <%= row.description %>
  </td>
  <td class="font-medium whitespace-nowrap">
    ₺<%= row.formatted_monthly_price %>
  </td>

  <td class="text-right">
    <%= modal_trigger "Fiyatı Düzenle", edit_admin_membership_plan_path(row), variant: :ghost %>
  </td>
</tr>
