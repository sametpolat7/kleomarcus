<%# locals: row: %>
<tr class="hover:bg-base-200/40 transition-colors">
  <td class="font-medium">
    <%= Lesson.day_name(row.day_of_week) %>
  </td>
  <td class="text-base-content/70 whitespace-nowrap">
    <%= lesson_time_range(row) %>
  </td>
  <td>
    <%= row.name %>
  </td>
  <td>
    <%= lesson_kind_label(row) %>
  </td>
  <td class="text-base-content/70">
    <%= row.trainer&.name || "—" %>
  </td>

  <td class="text-right">
    <div class="inline-flex gap-1">
      <%= modal_trigger "Düzenle", edit_admin_lesson_path(row), variant: :ghost %>
      <%= button_to "Sil", admin_lesson_path(row),
            method: :delete,
            class: "btn btn-sm btn-ghost text-error",
            form: { data: { turbo_confirm: "“#{row.name}” dersini silmek istediğinize emin misiniz?" } } %>
    </div>
  </td>
</tr>
