<tr class="hover:bg-base-200/40 transition-colors">
  <td><span class="font-medium"><%= row.full_name %></span></td>
  <td class="text-base-content/70"><%= row.discipline.name %></td>
  <td>
    <div class="flex flex-col">
      <a href="tel:<%= row.phone %>" class="text-sm hover:text-primary transition-colors"><%= format_phone(row.phone) %></a>
      <% if row.email.present? %>
        <a href="mailto:<%= row.email %>" class="text-xs text-base-content/60 hover:text-primary transition-colors"><%= row.email %></a>
      <% end %>
    </div>
  </td>
  <td class="text-base-content/70"><%= row.age %></td>
  <td><%= enrollment_level_label(row) %></td>
  <td><%= enrollment_status_label(row) %></td>
  <td class="text-base-content/70"><%= format_date(row.created_at) %></td>

  <td class="text-right">
    <div class="inline-flex gap-1">
      <%= modal_trigger "Düzenle", edit_admin_enrollment_path(row), variant: :ghost %>
      <%= button_to "Sil", admin_enrollment_path(row),
            method: :delete,
            class: "btn btn-sm btn-ghost text-error",
            form: { data: { turbo_confirm: "“#{row.full_name}” başvurusunu silmek istediğinize emin misiniz?" } } %>
    </div>
  </td>
</tr>
