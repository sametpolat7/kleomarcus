<% content_for :title, "Başvuru Detayı · Kleomarcus Admin" %>

<div class="admin-card max-w-3xl mx-auto">
  <%= turbo_frame_tag "admin_modal_frame" do %>

    <%= admin_modal_header "Başvuru Detayı",
          subtitle: @enrollment.full_name,
          cancel_path: admin_enrollments_path %>

    <div class="p-6">
      <%= render "admin/enrollments/form", enrollment: @enrollment %>
    </div>

  <% end %>
</div>
