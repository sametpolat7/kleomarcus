<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8">
    <title><%= content_for(:title) || "Kleomarcus Admin" %></title>
    <meta name="application-name" content="Kleomarcus">

    <%# Mobile-First Viewport %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <meta name="robots" content="noindex, nofollow">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Apply theme before paint so the brand palette is correct on first load (incl. login page) %>
    <%= javascript_tag nonce: true do %>
      (function () {
        var theme = localStorage.getItem("theme");
        if (!theme) {
          theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dracula" : "pastel";
        }
        document.documentElement.dataset.theme = theme;
      })();
    <% end %>

    <%# Favicons %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <%= yield :head %>

    <%# Fonts %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Russo+One&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">

    <%# Stylesheets & Scripts %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base-200 text-base-content">
    <%= render "shared/flash" %>

    <% if authenticated? %>
      <div class="drawer lg:drawer-open">
        <input id="admin-drawer" type="checkbox" class="drawer-toggle">

        <div class="drawer-content flex flex-col min-h-screen min-w-0">
          <%= render "shared/admin/navbar" %>
          <main class="flex-1 w-full max-w-7xl mx-auto p-4 sm:p-6 lg:p-8">
            <%= yield %>
          </main>
        </div>

        <div class="drawer-side z-40">
          <label for="admin-drawer" aria-label="Menüyü kapat" class="drawer-overlay"></label>
          <%= render "shared/admin/sidebar" %>
        </div>
      </div>

      <%= render "shared/admin/modal" %>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
