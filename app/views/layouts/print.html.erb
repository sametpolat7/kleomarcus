<!DOCTYPE html>
<html lang="tr" data-theme="pastel">
  <head>
    <meta charset="UTF-8">
    <title><%= content_for(:title) || "Kleomarcus Admin" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Russo+One&family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      @page { size: A4; margin: 0; }
      html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    </style>
  </head>

  <body class="min-h-screen bg-base-200 text-secondary print:bg-white">
    <%= yield %>
  </body>
</html>
