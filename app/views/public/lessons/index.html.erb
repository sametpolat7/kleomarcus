<%# SEO Meta Tags %>
<%= set_seo_meta(
  title: "Ders Programı",
  description: "#{club.name} haftalık ders programı. #{club_discipline_names.to_sentence(last_word_connector: " ve ")} branşlarında Minikler, Gençler ve Yetişkinler için grup antrenmanları ve bireysel ders saatleri. Hafta içi ve hafta sonu programları.",
  keywords: "kleomarcus ders programı, çanakkale dövüş ders saatleri, boks dersi çanakkale, kick boks dersi çanakkale, muay thai dersi çanakkale, çocuk dövüş dersi çanakkale, yetişkin dövüş eğitimi, grup antrenmanı çanakkale, bireysel antrenman saatleri, haftalık antrenman programı",
  og_description: "#{club.name} haftalık ders programı — Minikler, Gençler ve Yetişkinler için grup antrenmanları ve bireysel ders saatleri.",
  og_image: "public/hero-desktop.jpeg"
) %>

<%# Structured Data %>
<% content_for :structured_data do %>
  <%= structured_data_tag({
    "@context": "https://schema.org",
    "@type": "Schedule",
    "name": "#{club.name} Haftalık Ders Programı",
    "description": "#{club_discipline_names.to_sentence(last_word_connector: " ve ")} branşlarında Minikler, Gençler ve Yetişkinler için haftalık grup antrenmanı ve bireysel ders programı.",
    "url": canonical_url,
    "provider": organization_schema
  }) %>
<% end %>

<%# Hero Section %>
<%= render "shared/public/page_hero", title: "Ders Programı", image: "public/hero-desktop.jpeg", alt_text: "#{club.name} Ders Programı" %>

<%# Lessons Section %>
<section id="lessons" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-base-100" aria-labelledby="lessons-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <header class="mb-8 sm:mb-12 lg:mb-16">
      <h2 id="lessons-title" class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-base-content mb-3 sm:mb-4">
        Haftalık Program
      </h2>
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="h-[2px] w-8 sm:w-10 md:w-12 bg-primary"></div>
        <div class="w-1 h-1 sm:w-1.5 sm:h-1.5 bg-primary rotate-45"></div>
      </div>
      <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg text-base-content/70 max-w-2xl">
        Aşağıdaki tabloda haftalık ders programımızı görebilirsiniz. Detaylı bilgi ve kayıt için bizimle iletişime geçin.
      </p>
    </header>

    <%# Lessons Legend %>
    <div class="mb-6 sm:mb-8">
      <div class="flex flex-wrap gap-4 sm:gap-6">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 sm:w-4 sm:h-4 rounded-sm bg-primary"></div>
          <span class="text-xs sm:text-sm text-base-content/80">Grup Antrenmanı</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 sm:w-4 sm:h-4 rounded-sm bg-base-content/30"></div>
          <span class="text-xs sm:text-sm text-base-content/80">Özel Ders</span>
        </div>
      </div>
    </div>

    <%# Desktop Lessons Table %>
    <div class="hidden lg:block overflow-x-auto">
      <table class="w-full border-collapse bg-base-200 rounded-lg overflow-hidden shadow-lg">
        <thead>
          <tr class="bg-base-300">
            <th class="p-3 text-left font-display text-sm font-bold text-base-content border-b border-base-content/10 w-28">
              Saat
            </th>
            <% @schedule_days.each do |day| %>
              <th class="p-3 text-center font-display text-sm font-bold text-base-content border-b border-base-content/10">
                <%= Lesson.day_name(day) %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @schedule_hours.each do |start_time, end_time| %>
            <tr class="hover:bg-base-300/50 transition-colors">
              <td class="p-3 font-mono text-sm text-base-content/70 border-b border-base-content/5 bg-base-300/30">
                <%= start_time %>-<%= end_time %>
              </td>
              <% @schedule_days.each do |day| %>
                <% kind = @schedule_kinds.dig(day, start_time) %>
                <td class="p-2 border-b border-base-content/5 text-center">
                  <% if kind %>
                    <div class="<%= kind == 'team' ? 'bg-primary text-primary-content' : 'bg-base-content/20 text-base-content/70' %> text-xs sm:text-sm font-medium py-2 px-2 rounded-md shadow-sm">
                      <%= kind == 'team' ? 'Grup Antrenmanı' : 'Özel Ders' %>
                    </div>
                  <% else %>
                    <div class="text-base-content/20 text-xs">—</div>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Mobile Lesson Cards %>
    <div class="lg:hidden space-y-6">
      <% @schedule_days.each do |day| %>
        <% if @schedule_hours.any? { |start_time, _| @schedule_kinds.dig(day, start_time) } %>
          <div class="bg-base-200 rounded-lg overflow-hidden shadow-md">
            <div class="bg-base-300 px-4 py-3">
              <h3 class="font-display text-lg font-bold text-base-content"><%= Lesson.day_name(day) %></h3>
            </div>
            <div class="p-4 space-y-3">
              <% @schedule_hours.each do |start_time, end_time| %>
                <% kind = @schedule_kinds.dig(day, start_time) %>
                <% if kind %>
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-sm text-base-content/70 w-24 flex-shrink-0"><%= start_time %>-<%= end_time %></span>
                    <div class="<%= kind == 'team' ? 'bg-primary text-primary-content' : 'bg-base-content/20 text-base-content/70' %> text-sm font-medium py-2 px-4 rounded-md shadow-sm flex-grow text-center">
                      <%= kind == 'team' ? 'Grup Antrenmanı' : 'Özel Ders' %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Info Note %>
    <div class="mt-8 sm:mt-10 p-4 sm:p-6 bg-primary/5 border border-primary/20 rounded-lg">
      <div class="flex items-start gap-3 sm:gap-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <h4 class="font-display font-bold text-base-content mb-1 sm:mb-2">Önemli Bilgi</h4>
          <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
            Program değişiklik gösterebilir. Güncel bilgi için sosyal medya hesaplarımızı takip edin veya doğrudan bizimle iletişime geçin.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<%# Call to Action Section %>
<section id="lessons-cta" class="py-12 sm:py-16 md:py-20 bg-base-200" aria-labelledby="lessons-cta-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="lessons-cta-title" class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-base-content mb-4 sm:mb-6">
        Hemen Kayıt Olun
      </h2>
      <div class="flex items-center justify-center gap-2 sm:gap-3 mb-6">
        <div class="h-px w-8 sm:w-12 bg-primary"></div>
        <div class="w-1.5 h-1.5 bg-primary rotate-45"></div>
        <div class="h-px w-8 sm:w-12 bg-primary"></div>
      </div>
      <p class="text-sm sm:text-base md:text-lg text-base-content/70 mb-6 sm:mb-8">
        Size uygun grubu ve saati seçtiniz mi? İlk dersiniz için hemen bizimle iletişime geçin.
      </p>
      <%= link_to root_path(anchor: "contact"), class: "btn btn-primary btn-lg gap-2 sm:gap-3 shadow-md hover:shadow-lg" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        İletişime Geçin
      <% end %>
    </div>
  </div>
</section>
