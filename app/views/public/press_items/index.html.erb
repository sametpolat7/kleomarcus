<%= set_seo_meta(
  title: "Basında Biz",
  description: "#{club.name} ve sporcularımız hakkında bağımsız yayınlarda çıkan haberler. Türkiye ve Balkan şampiyonalarındaki dereceler, milli takım görevleri ve kulüp haberleri — yayıncı, tarih ve kaynak linkiyle.",
  og_description: "#{club.name} ve sporcularımız hakkında bağımsız yayınlarda çıkan haberler — yayıncı, tarih ve kaynak linkiyle.",
  og_image: "public/gallery-break-two.jpeg"
) %>

<% content_for :structured_data do %>
  <%= structured_data_tag({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Basında Biz - #{club.name}",
    "description": seo_description,
    "url": canonical_url,
    "mainEntity": organization_schema.merge("subjectOf": press_schema(@press_items_by_year.values.flatten))
  }) %>
<% end %>

<%= render "shared/public/page_hero", title: "Basında Biz", image: "public/gallery-break-two.jpeg", alt_text: "Kleomarcus Spor Akademi Basında" %>

<section id="press" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-base-100" aria-labelledby="press-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <header class="mb-8 sm:mb-12 lg:mb-16 max-w-3xl">
      <h2 id="press-title" class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-base-content mb-3 sm:mb-4">
        Bağımsız Yayınlarda
      </h2>
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="h-[2px] w-8 sm:w-10 md:w-12 bg-primary"></div>
        <div class="w-1 h-1 sm:w-1.5 sm:h-1.5 bg-primary rotate-45"></div>
      </div>
      <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg text-base-content/70">
        Kulübümüz ve sporcularımız hakkında yerel ve ulusal yayınlarda çıkan haberler.
      </p>
    </header>

    <% if @press_items_by_year.any? %>
      <div class="max-w-4xl space-y-12 sm:space-y-16">
        <% @press_items_by_year.each do |year, items| %>
          <div>
            <h3 class="font-display text-xl sm:text-2xl font-bold text-primary mb-5 sm:mb-6">
              <%= year %>
            </h3>

            <ul class="space-y-4 sm:space-y-5">
              <% items.each do |item| %>
                <li class="bg-base-200 p-5 sm:p-6 md:p-7">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:text-sm text-base-content/60 mb-2">
                    <span class="font-semibold text-base-content/80"><%= item.publisher %></span>
                    <span aria-hidden="true">·</span>
                    <time datetime="<%= item.published_on.iso8601 %>"><%= l(item.published_on, format: "%d %B %Y") %></time>
                    <% if item.byline.present? %>
                      <span aria-hidden="true">·</span>
                      <span><%= item.byline %></span>
                    <% end %>
                    <span class="inline-flex items-center text-xs font-medium bg-primary/10 text-primary px-2 py-0.5 rounded-sm border border-primary/20">
                      <%= PressItem.enum_label(:publisher_kind, item.publisher_kind) %>
                    </span>
                  </div>

                  <h4 class="font-display text-base sm:text-lg md:text-xl font-bold text-base-content leading-snug">
                    <%= item.headline %>
                  </h4>

                  <% if item.quote.present? %>
                    <blockquote cite="<%= item.url %>" class="mt-3 pl-4 border-l-2 border-primary/40 text-sm sm:text-base text-base-content/75 italic">
                      <%= item.quote %>
                    </blockquote>
                  <% end %>

                  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                    <a href="<%= item.url %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-primary font-medium hover:underline">
                      Haberin tamamı
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                      </svg>
                    </a>
                    <% if item.archive_url.present? %>
                      <a href="<%= item.archive_url %>" target="_blank" rel="noopener" class="text-base-content/50 hover:text-base-content transition-colors">
                        Arşiv kopyası
                      </a>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm sm:text-base text-base-content/60">
        Yayınlanmış basın kaydı bulunmuyor.
      </p>
    <% end %>

  </div>
</section>
