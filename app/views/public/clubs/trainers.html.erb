<%# SEO Meta Tags %>
<% content_for :title, "Antrenörlerimiz | Kleomarcus" %>
<% content_for :description, "Kleomarcus Spor Akademi'nin deneyimli ve profesyonel antrenör kadrosunu tanıyın. Boks, Kick Boks, Muay Thai, Wushu ve MMA alanlarında uzman eğitmenlerimiz." %>
<% content_for :keywords, "kleomarcus antrenörler, çanakkale dövüş eğitmenleri, boks antrenörü, kick boks antrenörü, muay thai eğitmeni, mma eğitmeni" %>
<% content_for :og_title, "Antrenörlerimiz | Kleomarcus" %>
<% content_for :og_description, "Kleomarcus Spor Akademi'nin deneyimli ve profesyonel antrenör kadrosu." %>

<%# Structured Data %>
<% content_for :structured_data do %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "Kleomarcus Spor Akademi Antrenörleri",
      "description": "Kleomarcus Spor Akademi'nin profesyonel antrenör kadrosu",
      "url": "<%= request.original_url %>"
    }
  </script>
<% end %>

<%# Hero Section %>
<section class="relative min-h-[60svh] sm:min-h-[70svh] overflow-hidden bg-neutral-950 hidden md:block" aria-label="Antrenörlerimiz Hero">
  <%# Background %>
  <div class="absolute inset-0">
    <%= image_tag 'public/philosophy-kleomarcus.jpeg', alt: 'Kleomarcus Spor Akademi Kulübümüz', class: 'w-full h-full object-cover object-center', loading: 'eager' %>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-neutral-950/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950/80 via-transparent to-neutral-950/80"></div>
  </div>

  <%# Content %>
  <div class="relative z-10 min-h-[60svh] sm:min-h-[70svh] font-display flex flex-col justify-end container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">

    <%# Title %>
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-black text-white mb-4 sm:mb-6 leading-[0.95]">
      <span class="block">Antrenörlerimiz</span>
    </h1>

    <%# Decorative line %>
    <div class="relative w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg">
      <div class="h-[2px] sm:h-[3px] w-full bg-gradient-to-r from-primary via-primary/70 to-transparent"></div>
      <div class="absolute -left-1 top-1/2 -translate-y-1/2 w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rotate-45"></div>
    </div>
  </div>
</section>

<%# Trainers Grid Section %>
<section id="trainers" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-base-100" aria-labelledby="trainers-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <header class="mb-8 sm:mb-12 lg:mb-16">
      <h2 id="trainers-title" class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-base-content mb-3 sm:mb-4">
        Eğitmen Kadromuz
      </h2>
      <div class="flex items-center gap-2 sm:gap-3">
        <div class="h-[2px] w-8 sm:w-10 md:w-12 bg-primary"></div>
        <div class="w-1 h-1 sm:w-1.5 sm:h-1.5 bg-primary rotate-45"></div>
      </div>
      <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg text-base-content/70 max-w-2xl">
        Alanında uzman, deneyimli antrenörlerimizle hedeflerinize ulaşın. Her biri kendi branşında kanıtlanmış başarılara sahip eğitmenlerimiz, sizin gelişiminiz için burada.
      </p>
    </header>

    <%# Trainers Grid %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">

      <% trainers_data.each_with_index do |trainer, index| %>
        <div onclick="trainer_modal_<%= index %>.showModal()" class="bg-base-200 rounded-lg overflow-hidden shadow-md cursor-pointer flex flex-col h-full">
          <div class="aspect-[4/5] bg-gradient-to-br from-base-300 to-base-200 relative overflow-hidden">
            <%= image_tag trainer[:image], alt: trainer[:name], class: 'w-full h-full object-cover object-center', loading: 'lazy', width: '400', height: '500' %>
          </div>

          <div class="p-4 sm:p-5 lg:p-6 flex flex-col flex-grow">
            <h3 class="font-display text-lg sm:text-xl lg:text-2xl font-bold text-base-content mb-1">
              <%= trainer[:name] %>
            </h3>
            <p class="text-xs sm:text-sm lg:text-base text-primary font-medium mb-3">
              <%= trainer[:title] %>
            </p>

            <div class="flex flex-wrap gap-2 mb-3">
              <% trainer[:branches].each do |branch| %>
                <span class="inline-flex items-center text-xs font-medium bg-primary/10 text-primary px-2.5 py-1 rounded-sm border border-primary/20">
                  <%= branch %>
                </span>
              <% end %>
            </div>

            <p class="text-xs sm:text-sm text-base-content/70 leading-relaxed line-clamp-3 mt-auto">
              <%= trainer[:bio] %>
            </p>
          </div>
        </div>

        <%# Modal for Trainer Details %>
        <dialog id="trainer_modal_<%= index %>" class="modal modal-bottom sm:modal-middle transition-all duration-200">
          <div class="modal-box max-w-3xl p-6 sm:p-8 lg:p-10">
            <form method="dialog">
              <button class="btn btn-sm sm:btn-md btn-circle btn-ghost absolute right-2 top-2 sm:right-4 sm:top-4">✕</button>
            </form>

            <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-base-content mb-2 sm:mb-3">
              <%= trainer[:name] %>
            </h3>
            <p class="text-sm sm:text-base lg:text-lg text-primary font-semibold mb-4 sm:mb-6">
              <%= trainer[:title] %>
            </p>

            <div class="flex flex-wrap gap-2 mb-6 sm:mb-8">
              <% trainer[:branches].each do |branch| %>
                <span class="inline-flex items-center text-sm font-medium bg-primary/10 text-primary px-3 py-1.5 rounded-md border border-primary/20">
                  <%= branch %>
                </span>
              <% end %>
            </div>

            <% trainer[:bio].split("\n\n").each do |paragraph| %>
              <p class="text-sm sm:text-base lg:text-lg text-base-content/80 leading-relaxed mb-4 sm:mb-5">
                <%= paragraph %>
              </p>
            <% end %>
          </div>
          <form method="dialog" class="modal-backdrop">
            <button>close</button>
          </form>
        </dialog>
      <% end %>

    </div>
  </div>
</section>

<%# Call to Action Section %>
<section id="trainers-cta" class="py-12 sm:py-16 md:py-20 bg-base-200" aria-labelledby="trainers-cta-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h2 id="trainers-cta-title" class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-base-content mb-4 sm:mb-6">
        Bizimle Başlamaya Hazır mısınız?
      </h2>
      <div class="flex items-center justify-center gap-2 sm:gap-3 mb-6">
        <div class="h-px w-8 sm:w-12 bg-primary"></div>
        <div class="w-1.5 h-1.5 bg-primary rotate-45"></div>
        <div class="h-px w-8 sm:w-12 bg-primary"></div>
      </div>
      <p class="text-sm sm:text-base md:text-lg text-base-content/70 mb-6 sm:mb-8">
        Profesyonel antrenörlerimizle dövüş sanatları yolculuğunuza bugün başlayın. Daha ayrıntılı bilgi için bizimle iletişime geçin.
      </p>
      <%= link_to root_path(anchor: "contact"), class: "btn btn-primary btn-lg gap-2 sm:gap-3 shadow-md hover:shadow-lg" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        İletişime Geçin
      <% end %>
    </div>
  </div>
</section>
