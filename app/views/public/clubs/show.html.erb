<%# SEO Meta Tags for Club Page %>
<% content_for :title, "Kulübümüz Hakkında | Kleomarcus Spor Akademi" %>
<% content_for :description, "Kleomarcus Spor Akademi - Çanakkale'nin köklü dövüş kulübü. Modern tesisler, profesyonel antrenörler, kapsamlı programlar. Boks, Kick Boks, Muay Thai, Wushu eğitimleri." %>
<% content_for :keywords, "kleomarcus hakkında, çanakkale dövüş kulübü, spor akademisi, boks, kick boks, muay thai, wushu, profesyonel antrenör" %>
<% content_for :og_title, "Kulübümüz Hakkında | Kleomarcus Spor Akademi" %>
<% content_for :og_description, "Çanakkale'nin köklü dövüş kulübü. Modern tesisler ve profesyonel antrenörlerle eğitim." %>
<% content_for :og_image, image_url('public/our-club.jpeg') %>

<%# Structured Data for SEO %>
<% content_for :structured_data do %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "Kulübümüz - Kleomarcus Spor Akademi",
      "description": "Çanakkale'nin köklü dövüş kulübü. Modern tesisler ve profesyonel antrenörlerle eğitim.",
      "url": "<%= request.original_url %>",
      "mainEntity": {
        "@type": "SportsClub",
        "name": "Kleomarcus Spor Akademi",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Merkez",
          "addressRegion": "Çanakkale",
          "addressCountry": "TR"
        }
      }
    }
  </script>
<% end %>

<%# Hero Section %>
<section class="relative min-h-[60svh] sm:min-h-[70svh] overflow-hidden bg-neutral-950 hidden md:block" aria-label="Kulübümüz Hero">
  <%# Background %>
  <div class="absolute inset-0">
    <%= image_tag 'public/our-club.jpeg', alt: 'Kleomarcus Spor Akademi Kulübümüz', class: 'w-full h-full object-cover object-center', loading: 'eager' %>
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-neutral-950/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950/80 via-transparent to-neutral-950/80"></div>
  </div>

  <%# Content %>
  <div class="relative z-10 min-h-[60svh] sm:min-h-[70svh] font-display flex flex-col justify-end container mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">

    <%# Title %>
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-black text-white mb-4 sm:mb-6 leading-[0.95]">
      <span class="block">Kulübümüz</span>
    </h1>

    <%# Decorative line %>
    <div class="relative w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg">
      <div class="h-[2px] sm:h-[3px] w-full bg-gradient-to-r from-primary via-primary/70 to-transparent"></div>
      <div class="absolute -left-1 top-1/2 -translate-y-1/2 w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rotate-45"></div>
    </div>
  </div>
</section>

<%# About Section %>
<section id="about" class="py-10 sm:py-12 md:py-16 lg:py-20 bg-base-100" aria-labelledby="about-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 md:gap-10 lg:gap-14 max-w-6xl mx-auto items-center">

      <%# Content %>
      <div class="order-1">
        <header class="mb-5 sm:mb-6 md:mb-7">
          <h2 id="about-title" class="font-display text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-base-content mb-2 sm:mb-3 md:mb-4">
            Biz Kimiz
          </h2>
          <div class="flex items-center gap-2 sm:gap-3">
            <div class="h-[2px] w-8 sm:w-10 md:w-12 bg-primary"></div>
            <div class="w-1 h-1 sm:w-1.5 sm:h-1.5 bg-primary rotate-45"></div>
          </div>
        </header>

        <div class="space-y-3 sm:space-y-4 text-base-content/80">
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
            Kleomarcus Spor Akademi, Çanakkale'nin önde gelen dövüş sporları kulübü olarak 2018? yılından bu yana faaliyetlerini sürdürmektedir.
            <span class="text-primary font-display">Boks,</span>
            <span class="text-primary font-display">Kick Boks,</span>
            <span class="text-primary font-display">Muay Thai,</span>
            <span class="text-primary font-display">Wushu,</span>
            <span class="text-primary font-display">MMA ve CrossFit</span>
            branşlarında tecrübeli eğitmenlerimiz eşliğinde profesyonel eğitimler sunuyoruz. Modern altyapımız ve genişleyen kapasite hedeflerimizle fark yaratmaya devam ediyoruz.
          </p>
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
            Misyonumuz, sadece dövüş tekniklerini öğretmek değil; sporcularımıza yaşam boyu taşıyacakları disiplin, öz güven ve zihinsel dayanıklılık kazandırmaktır. Bilimsel antrenman metodolojileri ve bireysel gelişim planlarıyla her sporcunun potansiyelini en üst seviyeye çıkarmayı hedefliyoruz. Başarımız, işimizi severek yapmamızdan geliyor.
          </p>
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
            Amatörden profesyonele, çocuktan yetişkine her seviyeden sporcuya özel programlar uyguluyoruz. Temel seviye eğitimlerden ulusal ve uluslararası müsabaka hazırlıklarına kadar geniş bir yelpazede hizmet veriyoruz. Sporcularımızın bölgesel ve ulusal şampiyonalarda elde ettiği başarılar, kalitemizin en somut göstergesidir.
          </p>
        </div>
      </div>

      <%# Stats %>
      <div class="order-2">
        <div class="grid grid-cols-2 gap-3 sm:gap-4 md:gap-5">
          <div class="bg-base-200 p-4 sm:p-5 md:p-6 lg:p-7 text-center">
            <span class="block font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-1">6</span>
            <span class="text-xs sm:text-sm text-base-content/70 uppercase tracking-wide">Branş</span>
          </div>
          <div class="bg-base-200 p-4 sm:p-5 md:p-6 lg:p-7 text-center">
            <span class="block font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-1">5+</span>
            <span class="text-xs sm:text-sm text-base-content/70 uppercase tracking-wide">Antrenör</span>
          </div>
          <div class="bg-base-200 p-4 sm:p-5 md:p-6 lg:p-7 text-center">
            <span class="block font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-1">7</span>
            <span class="text-xs sm:text-sm text-base-content/70 uppercase tracking-wide">Gün Açık</span>
          </div>
          <div class="bg-base-200 p-4 sm:p-5 md:p-6 lg:p-7 text-center">
            <span class="block font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-1">800+</span>
            <span class="text-xs sm:text-sm text-base-content/70 uppercase tracking-wide">m² Salon</span>
            <p class="text-xs md:text-sm text-base-content/60 mt-1">(Yeni salonumuzla birlikte)</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<%# Philosophy Section %>
<section id="philosophy" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-base-200" aria-labelledby="philosophy-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <header class="text-center mb-8 sm:mb-10 lg:mb-12">
      <h2 id="philosophy-title" class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-base-content mb-3 sm:mb-4">
        Yaklaşımımız
      </h2>
      <div class="flex items-center justify-center gap-2 sm:gap-3">
        <div class="h-px w-8 sm:w-12 bg-primary"></div>
        <div class="w-1.5 h-1.5 bg-primary rotate-45"></div>
        <div class="h-px w-8 sm:w-12 bg-primary"></div>
      </div>
    </header>

    <div class="max-w-4xl mx-auto">
      <div class="space-y-6 sm:space-y-8">

        <%# Item 1 %>
        <div class="flex gap-4 sm:gap-6">
          <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 flex items-center justify-center">
            <span class="font-display text-lg sm:text-xl font-bold text-primary">01</span>
          </div>
          <div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-base-content mb-2">Süreklilik ve Disiplin</h3>
            <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
              Sporcu gelişimi, düzenli ve sistematik çalışmanın ürünüdür. Antrenmanlar, beslenme programı ve dinlenme günleri bütünlüğü içinde çalışırız. Başarı, günlük disiplinin doğal sonucudur - kestirme yol aramayız.
            </p>
          </div>
        </div>

        <%# Item 2 %>
        <div class="flex gap-4 sm:gap-6">
          <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 flex items-center justify-center">
            <span class="font-display text-lg sm:text-xl font-bold text-primary">02</span>
          </div>
          <div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-base-content mb-2">Bilimsel Antrenman Yaklaşımı</h3>
            <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
              Ham güç değil, mükemmel teknik bizim temelimizdir. Duruşlar ve vuruşların yanı sıra modern spor bilimi prensipleriyle hareketlerin analizi, zamanlama ve mesafe kontrolünü de öğretiyoruz. Temel tekniklerde ustalaşmadan ileri seviyeye geçiş yoktur. Her hamle, bilinçli tekrar ve düzeltmelerle kusursuzlaşır.
            </p>
          </div>
        </div>

        <%# Item 3 %>
        <div class="flex gap-4 sm:gap-6">
          <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 flex items-center justify-center">
            <span class="font-display text-lg sm:text-xl font-bold text-primary">03</span>
          </div>
          <div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-base-content mb-2">Karakter ve Etik Değerler</h3>
            <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
              Dövüş sanatları, fiziksel gücün ötesinde karakter inşasıdır. Antrenörlerimize, spor arkadaşlarımıza ve rakiplerimize duyulan saygı, kulübümüzün temel ilkesidir. Salondaki disiplin, yaşamın her alanına yansır. Güçlü bir karakter, güçlü bir sporcu yaratır.
            </p>
          </div>
        </div>

        <%# Item 4 %>
        <div class="flex gap-4 sm:gap-6">
          <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 flex items-center justify-center">
            <span class="font-display text-lg sm:text-xl font-bold text-primary">04</span>
          </div>
          <div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-base-content mb-2">Hedef Odaklı Gelişim</h3>
            <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
              Başarı, ayların ve yılların ürünüdür. Her sporcu için bireysel gelişim planları oluşturur, ölçülebilir hedefler belirleriz. Kısa vadeli kazanımlar değil, uzun vadeli sporcu gelişimi önceliğimizdir. Zorlu antrenmanlar, büyük başarılar doğurur.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%# CTA Section %>
