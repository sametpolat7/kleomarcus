<%# SEO Meta Tags for Club Page %>
<%= set_seo_meta(
  title: "Kulübümüz",
  description: "Kleomarcus Spor Akademi - Çanakkale'nin köklü dövüş kulübü. Modern tesisler, profesyonel antrenörler, kapsamlı programlar. Boks, Kick Boks, Muay Thai, Wushu eğitimleri.",
  keywords: "kleomarcus hakkında, çanakkale dövüş kulübü, spor akademisi, boks, kick boks, muay thai, wushu, profesyonel antrenör",
  og_description: "Çanakkale'nin köklü dövüş kulübü. Modern tesisler ve profesyonel antrenörlerle eğitim.",
  og_image: "public/our-club.jpeg"
) %>

<%# Structured Data for SEO %>
<% content_for :structured_data do %>
  <%= structured_data_tag({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Kulübümüz - Kleomarcus Spor Akademi",
    "description": "Çanakkale'nin köklü dövüş kulübü. Modern tesisler ve profesyonel antrenörlerle eğitim.",
    "url": request.original_url,
    "mainEntity": organization_schema
  }) %>
<% end %>

<%# Hero Section %>
<%= render "shared/page_hero", title: "Kulübümüz", image: "public/our-club.jpeg", alt_text: "Kleomarcus Spor Akademi Kulübümüz" %>

<%# About Section %>
<section id="about" class="py-10 sm:py-12 md:py-16 lg:py-20 bg-base-100" aria-labelledby="about-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 md:gap-10 lg:gap-14 max-w-6xl mx-auto items-center">

      <%# Content %>
      <div class="order-1">
        <header class="mb-5 sm:mb-6 md:mb-7">
          <h2 id="about-title" class="font-display text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-base-content mb-2 sm:mb-3 md:mb-4">
            Biz Kimiz
          </h2>
          <div class="flex items-center gap-2 sm:gap-3">
            <div class="h-[2px] w-8 sm:w-10 md:w-12 bg-primary"></div>
            <div class="w-1 h-1 sm:w-1.5 sm:h-1.5 bg-primary rotate-45"></div>
          </div>
        </header>

        <div class="space-y-3 sm:space-y-4 text-base-content/80">
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
            Kleomarcus Spor Akademi, Çanakkale'nin önde gelen dövüş sporları kulübüdür.
            <span class="text-primary font-display">Boks,</span>
            <span class="text-primary font-display">Kick Boks,</span>
            <span class="text-primary font-display">Muay Thai,</span>
            <span class="text-primary font-display">Wushu,</span>
            <span class="text-primary font-display">MMA ve CrossFit</span>
            branşlarında profesyonel eğitimler sunuyoruz.
          </p>
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
            Misyonumuz, sporcularımıza teknik bilginin yanı sıra disiplin, öz güven ve zihinsel dayanıklılık kazandırmaktır. Bireysel gelişim planlarıyla her sporcunun potansiyelini en üst seviyeye çıkarıyoruz.
          </p>
          <p class="text-sm sm:text-base md:text-lg leading-relaxed">
            Çocuktan yetişkine, amatörden profesyonele her seviyeye özel programlar uyguluyoruz. Sporcularımızın ulusal şampiyonalardaki başarıları, kalitemizin en somut göstergesidir.
          </p>
        </div>
      </div>

      <%# Stats %>
      <div class="order-2">
        <div class="grid grid-cols-2 gap-3 sm:gap-4 md:gap-5">
          <div class="bg-base-200 p-4 sm:p-5 md:p-6 lg:p-7 text-center">
            <span class="block font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-1">6</span>
            <span class="text-xs sm:text-sm text-base-content/70 uppercase tracking-wide">Branş</span>
          </div>
          <div class="bg-base-200 p-4 sm:p-5 md:p-6 lg:p-7 text-center">
            <span class="block font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-1">5+</span>
            <span class="text-xs sm:text-sm text-base-content/70 uppercase tracking-wide">Antrenör</span>
          </div>
          <div class="bg-base-200 p-4 sm:p-5 md:p-6 lg:p-7 text-center">
            <span class="block font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-1">7</span>
            <span class="text-xs sm:text-sm text-base-content/70 uppercase tracking-wide">Gün Açık</span>
          </div>
          <div class="bg-base-200 p-4 sm:p-5 md:p-6 lg:p-7 text-center">
            <span class="block font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-primary mb-1">800+</span>
            <span class="text-xs sm:text-sm text-base-content/70 uppercase tracking-wide">m² Salon</span>
            <p class="text-xs md:text-sm text-base-content/60 mt-1">(Yeni salonumuzla birlikte)</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<%# Philosophy Section %>
<section id="philosophy" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-base-200" aria-labelledby="philosophy-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <header class="text-center mb-8 sm:mb-10 lg:mb-12">
      <h2 id="philosophy-title" class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-base-content mb-3 sm:mb-4">
        Yaklaşımımız
      </h2>
      <div class="flex items-center justify-center gap-2 sm:gap-3">
        <div class="h-px w-8 sm:w-12 bg-primary"></div>
        <div class="w-1.5 h-1.5 bg-primary rotate-45"></div>
        <div class="h-px w-8 sm:w-12 bg-primary"></div>
      </div>
    </header>

    <div class="max-w-4xl mx-auto">
      <div class="space-y-6 sm:space-y-8">

        <%# Item 1 %>
        <div class="flex gap-4 sm:gap-6">
          <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 flex items-center justify-center">
            <span class="font-display text-lg sm:text-xl font-bold text-primary">01</span>
          </div>
          <div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-base-content mb-2">Süreklilik ve Disiplin</h3>
            <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
              Başarı, günlük disiplinin doğal sonucudur. Antrenman, beslenme ve dinlenme bütünlüğü içinde çalışırız — kestirme yol aramayız.
            </p>
          </div>
        </div>

        <%# Item 2 %>
        <div class="flex gap-4 sm:gap-6">
          <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 flex items-center justify-center">
            <span class="font-display text-lg sm:text-xl font-bold text-primary">02</span>
          </div>
          <div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-base-content mb-2">Bilimsel Antrenman Yaklaşımı</h3>
            <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
              Ham güç değil, mükemmel teknik temelimizdir. Modern spor bilimi prensipleriyle çalışır, temel tekniklerde ustalaşmadan ileri seviyeye geçmeyiz.
            </p>
          </div>
        </div>

        <%# Item 3 %>
        <div class="flex gap-4 sm:gap-6">
          <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 flex items-center justify-center">
            <span class="font-display text-lg sm:text-xl font-bold text-primary">03</span>
          </div>
          <div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-base-content mb-2">Karakter ve Etik Değerler</h3>
            <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
              Dövüş sanatları, fiziksel gücün ötesinde karakter inşasıdır. Saygı ve disiplin kulübümüzün temel ilkesidir — güçlü bir karakter, güçlü bir sporcu yaratır.
            </p>
          </div>
        </div>

        <%# Item 4 %>
        <div class="flex gap-4 sm:gap-6">
          <div class="flex-shrink-0 w-10 h-10 sm:w-12 sm:h-12 bg-primary/10 flex items-center justify-center">
            <span class="font-display text-lg sm:text-xl font-bold text-primary">04</span>
          </div>
          <div>
            <h3 class="font-display text-lg sm:text-xl font-bold text-base-content mb-2">Hedef Odaklı Gelişim</h3>
            <p class="text-sm sm:text-base text-base-content/70 leading-relaxed">
              Her sporcu için bireysel gelişim planları ve ölçülebilir hedefler belirleriz. Uzun vadeli sporcu gelişimi önceliğimizdir.
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<%# CTA Section %>
<section class="py-12 sm:py-16 md:py-20 lg:py-24 bg-primary text-primary-content" aria-labelledby="cta-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">

      <h2 id="cta-title" class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4 sm:mb-6">
        Potansiyelinizi Keşfedin
      </h2>
      <p class="text-sm sm:text-base md:text-lg opacity-90 mb-6 sm:mb-8 leading-relaxed">
        Üyelik seçenekleri, antrenman programları ve tüm sorularınız için bize ulaşın.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="tel:+905470230899" class="btn btn-lg btn-outline border-2 border-primary-content text-primary-content hover:bg-primary-content hover:text-primary transition-all duration-300">
          Bizi Ara
        </a>
        <span class="text-sm opacity-70">veya</span>
        <a href="https://wa.me/905470230899" target="_blank" rel="noopener noreferrer" class="text-sm sm:text-base underline hover:opacity-100 opacity-80">
          WhatsApp'tan yaz
        </a>
      </div>

    </div>
  </div>
</section>
