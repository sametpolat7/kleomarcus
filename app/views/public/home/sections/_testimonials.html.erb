                </div>
                <blockquote class="text-base-content/70 italic">
                  "Kleomarcus'ta aldığım eğitim sayesinde ulusal takıma seçildim. Antrenörler gerçekten mükemmellik için çalışıyor."
                </blockquote>
                <%= star_rating(5) %>
              </div>
            </div>
          </article>

          <!-- Testimonial 5 -->
          <article class="flex-shrink-0 w-[90%] sm:w-[calc(50%-12px)] lg:w-[calc(50%-16px)]" data-carousel-target="slide" role="group" aria-roledescription="slide" aria-label="5 / 9: Selin M.">
            <div class="card bg-base-200 shadow-lg h-full">
              <div class="card-body">
                <div class="flex items-center gap-4 mb-4">
