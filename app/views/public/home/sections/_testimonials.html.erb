                  </div>
                </div>
                <blockquote class="text-base-content/70 italic">
                  "Forma girmek için geldim, özgüven ve yeni bir yaşam tarzıyla ayrıldım. Hayatımın en iyi kararı."
                </blockquote>
                <%= star_rating(4) %>
              </div>
            </div>
          </article>

          <!-- Testimonial 4 -->
          <article class="flex-shrink-0 w-[90%] sm:w-[calc(50%-12px)] lg:w-[calc(50%-16px)]" data-carousel-target="slide" role="group" aria-roledescription="slide" aria-label="4 / 9: Deniz S.">
            <div class="card bg-base-200 shadow-lg h-full">
              <div class="card-body">
                <div class="flex items-center gap-4 mb-4">
