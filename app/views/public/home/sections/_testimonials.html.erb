<section id="testimonials" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-base-100" aria-labelledby="testimonials-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <header class="text-center mb-8 sm:mb-12 lg:mb-16">
      <h2 id="testimonials-title" class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-base-content mb-3 sm:mb-4">
        Sporcularımızdan
      </h2>
    </header>

    <!-- Testimonials Carousel -->
    <div class="relative max-w-6xl mx-auto" data-controller="carousel" data-action="touchstart->carousel#touchStart touchmove->carousel#touchMove touchend->carousel#touchEnd" role="region" aria-roledescription="carousel" aria-label="Sporcularımızdan">

      <!-- Side Navigation - Hidden on mobile, visible on md+ -->
      <button type="button" class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 lg:-translate-x-8 xl:-translate-x-12 z-10 btn btn-circle btn-md lg:btn-lg bg-base-100 border-base-300 shadow-lg hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300" data-action="click->carousel#prev" aria-label="Önceki Yorum">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 lg:h-6 lg:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button type="button" class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 lg:translate-x-8 xl:translate-x-12 z-10 btn btn-circle btn-md lg:btn-lg bg-base-100 border-base-300 shadow-lg hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300" data-action="click->carousel#next" aria-label="Sonraki Yorum">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 lg:h-6 lg:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Carousel Track -->
      <div class="overflow-hidden md:mx-12 lg:mx-16">
        <div class="flex gap-4 sm:gap-6 lg:gap-8" data-carousel-target="track">
          <% testimonials_data.each_with_index do |t, i| %>
            <article class="flex-shrink-0 w-[90%] sm:w-[calc(50%-12px)] lg:w-[calc(50%-16px)]" data-carousel-target="slide" role="group" aria-roledescription="slide" aria-label="<%= "#{i + 1} / #{testimonials_data.size}: #{t[:name]}" %>">
              <div class="card bg-base-200 shadow-lg h-full">
                <div class="card-body">
                  <div class="flex items-center gap-4 mb-4">
                    <div class="avatar placeholder">
                      <div class="w-14 h-14 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 bg-primary text-primary-content flex items-center justify-center">
                        <span class="<%= t[:initials].length > 3 ? 'text-sm' : 'text-lg' %> font-bold"><%= t[:initials] %></span>
                      </div>
                    </div>
                    <div>
                      <h3 class="font-display font-bold text-base-content"><%= t[:name] %></h3>
                      <p class="text-primary text-sm"><%= t[:title] %></p>
                    </div>
                  </div>
                  <blockquote class="text-base-content/70 italic">
                    "<%= t[:quote] %>"
                  </blockquote>
                  <%= star_rating(t[:rating]) %>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      </div>

      <!-- Mobile Navigation - Visible only on mobile -->
      <div class="flex md:hidden justify-center items-center gap-4 mt-6">
        <button type="button" class="btn btn-circle btn-md bg-base-100 border-base-300 shadow-lg hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300" data-action="click->carousel#prev" aria-label="Önceki Yorum">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button type="button" class="btn btn-circle btn-md bg-base-100 border-base-300 shadow-lg hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300" data-action="click->carousel#next" aria-label="Sonraki Yorum">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

  </div>
</section>
