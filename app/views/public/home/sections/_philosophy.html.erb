<section id="philosophy" class="relative py-12 sm:py-16 md:py-20 lg:py-28 xl:py-32 overflow-hidden bg-base-100" aria-labelledby="philosophy-title">

  <%# Background Pattern %>
  <div class="absolute inset-0 opacity-[0.03] sm:opacity-5" aria-hidden="true">
    <div class="absolute inset-0" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 35px, currentColor 35px, currentColor 36px);"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <%# Header %>
    <header class="text-center mb-8 sm:mb-10 md:mb-12 lg:mb-16">
      <h2 id="philosophy-title" class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold text-base-content mb-3 sm:mb-4 md:mb-6">
        Felsefemiz
      </h2>
      <div class="flex items-center justify-center gap-2 sm:gap-3 md:gap-4">
        <div class="h-px w-8 sm:w-12 md:w-16 lg:w-24 bg-primary"></div>
        <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rotate-45"></div>
        <div class="h-px w-8 sm:w-12 md:w-16 lg:w-24 bg-primary"></div>
      </div>
    </header>

    <%# Main Content %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 md:gap-10 lg:gap-12 xl:gap-16 max-w-7xl mx-auto items-start lg:items-center">

      <%# Image %>
      <div class="order-2 lg:order-1 hidden lg:block">
        <%= image_tag "public/philosophy-kleomarcus.jpeg", alt: "Kleomarcus Spor Akademi antrenman alanı ve sporcular", class: "w-full max-w-xl lg:max-w-2xl object-cover aspect-[4/3] rounded-xl", loading: "lazy" %>
      </div>

      <%# Content %>
      <div class="order-1 lg:order-2 space-y-4 sm:space-y-5 md:space-y-6">

        <div class="space-y-4 sm:space-y-5 md:space-y-6 lg:space-y-5">
          <p class="font-display text-lg sm:text-xl md:text-2xl lg:text-2xl xl:text-3xl text-center lg:text-left">
            <span class="text-primary">KLEOMARCUS</span>
            <span class="text-secondary"> Spor Akademisinde</span>
          </p>
          <p class="text-sm sm:text-base md:text-lg lg:text-base xl:text-xl text-base-content/90 leading-relaxed text-center lg:text-left">
            Dövüş sporlarına tutkuyla bağlı bir ekip olarak, antrenmanı sadece bedeni çalıştırmak değil; disiplinle, emekle ve istikrarlı çalışmayla zaman içinde karşılığını veren bir çalışma düzeni olarak görüyoruz.
          </p>
        </div>

        <%# About Us Button %>
        <div class="pt-4 sm:pt-6 md:pt-8 lg:pt-6 xl:pt-8 flex justify-center lg:justify-end">
          <%= link_to club_path, class: "group relative inline-flex items-center gap-2 sm:gap-2.5 md:gap-3 px-3 py-2 sm:px-4 sm:py-2.5 md:px-5 md:py-3 lg:px-6 lg:py-3.5 overflow-hidden text-base-content transition-colors duration-500" do %>
            <span class="absolute top-0 left-0 w-0 h-px bg-primary group-hover:w-full transition-all duration-500 ease-out" aria-hidden="true"></span>
            <span class="absolute bottom-0 right-0 w-0 h-px bg-primary group-hover:w-full transition-all duration-500 ease-out" aria-hidden="true"></span>
            <span class="absolute top-0 left-0 w-px h-0 bg-primary group-hover:h-full transition-all duration-500 delay-100 ease-out" aria-hidden="true"></span>
            <span class="absolute bottom-0 right-0 w-px h-0 bg-primary group-hover:h-full transition-all duration-500 delay-100 ease-out" aria-hidden="true"></span>

            <span class="relative z-10 text-xs sm:text-sm md:text-base lg:text-sm xl:text-base font-medium tracking-wide group-hover:text-primary transition-colors duration-300">
              Kulübümüz Hakkında Daha Fazlası
            </span>

            <span class="relative z-10 flex items-center justify-center w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 lg:w-6 lg:h-6 xl:w-7 xl:h-7 ml-1 sm:ml-2">
              <span class="absolute inset-0 bg-primary/10 scale-0 group-hover:scale-100 transition-transform duration-300 ease-out" aria-hidden="true"></span>
              <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 md:w-4 md:h-4 relative z-10 text-base-content group-hover:text-primary group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </span>
          <% end %>
        </div>

      </div>

    </div>

  </div>
</section>
