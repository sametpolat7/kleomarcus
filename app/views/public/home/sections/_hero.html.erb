<section id="hero" class="relative min-h-[100svh] overflow-hidden bg-neutral-950" aria-label="Ana Sayfa Hero Bölümü">

  <!-- Background -->
  <div class="absolute inset-0">
    <picture>
      <source media="(min-width: 640px)" srcset="<%= image_path('public/hero-desktop.jpeg') %>">
      <%= image_tag 'public/hero-mobile.jpeg', alt: "Kleomarcus Mekan Görseli", class: "w-full h-full object-cover object-center", loading: "eager" %>
    </picture>

    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-neutral-950/30"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950/90 via-neutral-950/20 to-neutral-950/90"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 min-h-[100svh] font-display flex flex-col justify-center items-center text-center sm:justify-between sm:items-stretch sm:text-left px-5 sm:px-8 md:px-12 lg:px-16 xl:px-24 py-24 sm:py-28 lg:py-36">

    <!-- Slogan -->
    <div class="max-w-2xl">
      <h1 class="text-6xl md:text-7xl lg:text-8xl leading-[1.1] font-black">
        <span class="block text-white">Güç Senin</span>
        <span class="block text-white">İçinde</span>
      </h1>
      <p class="tracking-wide mt-3 sm:mt-4 md:mt-6 text-base sm:text-lg lg:text-2xl text-neutral-300">
        Açığa Çıkarmak
        <span class="relative inline-block text-xl sm:text-2xl lg:text-3xl text-primary tracking-wider font-semibold">
          BİZİM İŞİMİZ.
          <span class="absolute -bottom-1 left-0 w-full h-0.5 sm:h-[3px] bg-gradient-to-r from-primary via-primary to-transparent rounded-full"></span>
          <span class="absolute -bottom-1 left-0 w-3/4 h-0.5 sm:h-[3px] bg-primary/50 blur-sm rounded-full"></span>
        </span>
      </p>
    </div>

    <!-- Bottom -->
    <div class="flex flex-col items-center gap-8 mt-12 sm:mt-0 sm:flex-row sm:items-end sm:justify-between">

      <!-- Rotating Text -->
      <div class="text-center sm:text-left">
        <span class="block text-neutral-400 text-sm sm:text-base tracking-wider mb-2 sm:mb-3">
          BRANŞLARIMIZ
        </span>
        <p class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl text-white font-bold tracking-tight">
          <span class="text-rotate">
            <span class="justify-items-center sm:justify-items-start">
              <span class="flex items-center gap-2 sm:gap-3">
                <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rounded-full"></span>
                Boks
              </span>
              <span class="flex items-center gap-2 sm:gap-3">
                <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rounded-full"></span>
                Kick Boks
              </span>
              <span class="flex items-center gap-2 sm:gap-3">
                <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rounded-full"></span>
                Muay Thai
              </span>
              <span class="flex items-center gap-2 sm:gap-3">
                <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rounded-full"></span>
                Wushu
              </span>
              <span class="flex items-center gap-2 sm:gap-3">
                <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rounded-full"></span>
                MMA
              </span>
              <span class="flex items-center gap-2 sm:gap-3">
                <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rounded-full"></span>
                CrossFit
              </span>
            </span>
          </span>
        </p>
      </div>

      <!-- Go Button -->
      <div>
        <a href="#contact" class="group inline-flex items-center gap-2 sm:gap-3 bg-primary hover:bg-primary/90 text-primary-content px-5 sm:px-6 md:px-8 py-3 md:py-4 text-xs sm:text-sm md:text-base font-bold uppercase tracking-wider transition-all duration-300 sm:hover:gap-4">
          Hemen Başla
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>

    </div>

  </div>

</section>
