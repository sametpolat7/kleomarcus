<section id="membership" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-base-100" aria-labelledby="membership-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <header class="text-center mb-6 sm:mb-8 md:mb-12 lg:mb-16">
      <h2 id="membership-title" class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-base-content mb-2 sm:mb-3 md:mb-4">
        Üyelik Paketleri
      </h2>
      <p class="text-base-content/70 max-w-2xl mx-auto text-sm sm:text-base md:text-lg">
        Size en uygun paketi seçin ve hemen başlayın
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 max-w-5xl mx-auto">
      <% @membership_plans.each do |plan| %>
        <% featured = plan.featured? %>
        <article class="<%= class_names("card transition-shadow", featured ? "bg-primary text-primary-content shadow-2xl md:scale-105 z-10 hover:shadow-3xl" : "bg-base-200 shadow-xl hover:shadow-2xl") %>">
          <div class="<%= class_names("card-body text-center p-4 sm:p-6", relative: featured) %>">
            <% if featured %>
              <div class="badge badge-secondary badge-sm sm:badge-md absolute top-3 right-3 sm:top-4 sm:right-4 font-semibold text-xs sm:text-sm" role="status" aria-label="En popüler paket">
                Popüler
              </div>
            <% end %>
            <h3 class="<%= class_names("font-display text-lg sm:text-xl md:text-2xl font-bold", "text-base-content": !featured) %>"><%= plan.name %></h3>
            <p class="<%= class_names("text-xs sm:text-sm mb-3 sm:mb-4", featured ? "opacity-80" : "text-base-content/60") %>"><%= plan.description %></p>
            <div class="mb-4 sm:mb-6" aria-label="Aylık <%= plan.formatted_monthly_price %> lira">
              <span class="<%= class_names("font-display text-2xl sm:text-3xl md:text-4xl font-bold", "text-base-content": !featured) %>">₺<%= plan.formatted_monthly_price %></span>
              <span class="<%= class_names("text-sm sm:text-base", featured ? "opacity-80" : "text-base-content/60") %>">/ay</span>
            </div>
            <ul class="space-y-2 sm:space-y-3 text-left mb-6 sm:mb-8 text-sm sm:text-base" role="list">
              <% plan.features.each do |feature| %>
                <li class="<%= class_names("flex items-start gap-2", featured ? "opacity-90" : "text-base-content/80") %>">
                  <svg class="<%= class_names("w-4 h-4 sm:w-5 sm:h-5 flex-shrink-0 mt-0.5", "text-primary": !featured) %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span><%= feature %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </article>
      <% end %>
    </div>

    <p class="text-center text-base-content/60 text-xs sm:text-sm mt-6 sm:mt-8 px-4">
      * Eşli özel ders paketlerinde, paket ücretlerinin toplamı üzerinden %10 indirim uygulanır.
    </p>

    <p class="text-center text-base-content/90 text-xs sm:text-sm mt-3 sm:mt-4 px-4">
      <span class="badge badge-primary badge-xs sm:badge-sm mr-1.5 align-middle">Yakında</span>
      <span class="text-base-content font-display">Kleomarcus Plus</span> şubemiz için yeni üyelik paketleri duyurulacaktır.
    </p>

  </div>
</section>
