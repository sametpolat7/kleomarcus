<section id="first-quote" class="relative py-20 sm:py-28 md:py-36 lg:py-44 xl:py-52 overflow-hidden" aria-labelledby="first-quote-content">

  <%# Background Image with Overlay %>
  <div class="absolute inset-0">
    <%= image_tag 'public/first-quote-bg.jpeg', alt: 'Kleomarcus İç Mekan', class: 'w-full h-full object-cover object-center', loading: 'lazy', aria: { hidden: true } %>

    <div class="absolute inset-0 bg-gradient-to-b from-base-300/20 via-base-300/75 to-base-300/20"></div>
    <div class="absolute inset-0 bg-primary/5"></div>
  </div>

  <%# Quote Content %>
  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8">
    <figure class="max-w-4xl mx-auto text-center">

      <%# Top Decorative Element %>
      <div class="flex items-center justify-center gap-3 sm:gap-4 mb-8 sm:mb-10 lg:mb-12" aria-hidden="true">
        <div class="h-px w-12 sm:w-16 md:w-20 lg:w-24 bg-gradient-to-r from-transparent to-primary"></div>
        <svg class="w-6 h-6 sm:w-8 sm:h-8 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>
        <div class="h-px w-12 sm:w-16 md:w-20 lg:w-24 bg-gradient-to-l from-transparent to-primary"></div>
      </div>

      <%# Quote Text %>
      <blockquote>
        <p id="first-quote-content" class="font-display text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-bold text-base-content leading-tight px-4 sm:px-8">
          "Ringde yalnız değilsin.<br class="hidden xs:block">
          <span class="text-primary">Emeğin</span> seninle."
        </p>
      </blockquote>

      <%# Bottom Decorative Element %>
      <div class="flex items-center justify-center gap-3 sm:gap-4 mt-8 sm:mt-10 lg:mt-12" aria-hidden="true">
        <div class="h-px w-16 sm:w-20 md:w-24 bg-gradient-to-r from-transparent to-primary/60"></div>
        <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 bg-primary rotate-45 flex-shrink-0"></div>
        <div class="h-px w-16 sm:w-20 md:w-24 bg-gradient-to-l from-transparent to-primary/60"></div>
      </div>
    </figure>
  </div>
</section>
