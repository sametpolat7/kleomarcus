<section id="programs" class="py-12 sm:py-16 md:py-20 lg:py-24 bg-base-200" aria-labelledby="programs-title">

  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <header class="text-center mb-8 sm:mb-12 lg:mb-16">
      <h2 id="programs-title" class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-base-content mb-3 sm:mb-4">
        Branşlarımız
      </h2>
      <p class="text-base-content/70 max-w-2xl mx-auto text-sm sm:text-base lg:text-lg">
        Dövüş branşlarımız ve bunları besleyen güç & kondisyon programlarımız — her seviyeye uygun, antrenör eşliğinde
      </p>
    </header>

    <!-- Programs Carousel -->
    <div class="relative max-w-6xl mx-auto" data-controller="carousel" data-action="touchstart->carousel#touchStart touchmove->carousel#touchMove touchend->carousel#touchEnd" role="region" aria-roledescription="carousel" aria-label="Branşlarımız">

      <!-- Side Navigation - Hidden on mobile, visible on md+ -->
      <button type="button" class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 lg:-translate-x-8 xl:-translate-x-12 z-10 btn btn-circle btn-md lg:btn-lg bg-base-100 border-base-300 shadow-lg hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300" data-action="click->carousel#prev" aria-label="Önceki Branş">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 lg:h-6 lg:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button type="button" class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 lg:translate-x-8 xl:translate-x-12 z-10 btn btn-circle btn-md lg:btn-lg bg-base-100 border-base-300 shadow-lg hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300" data-action="click->carousel#next" aria-label="Sonraki Branş">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 lg:h-6 lg:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Carousel Track -->
      <div class="overflow-hidden md:mx-12 lg:mx-16">
        <div class="flex gap-4 sm:gap-6 lg:gap-8" data-carousel-target="track">

          <% featured_club_disciplines.each_with_index do |discipline, index| %>
            <article class="flex-shrink-0 w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-21.33px)]" data-carousel-target="slide" role="group" aria-roledescription="slide" aria-label="<%= index + 1 %> / <%= featured_club_disciplines.size %>: <%= discipline[:name] %>">
              <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow duration-300 h-full">
                <figure class="h-40 sm:h-48 overflow-hidden">
                  <%= image_tag discipline[:image], alt: "#{discipline[:name]} antrenmanı", class: "w-full h-full object-cover hover:scale-105 transition-transform duration-500", loading: "lazy", width: "600", height: "400" %>
                </figure>
                <div class="card-body">
                  <h3 class="card-title font-display text-xl text-base-content"><%= discipline[:name] %></h3>
                  <p class="text-base-content/70 text-sm">
                    <%= discipline[:summary] %>
                  </p>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      </div>

      <!-- Mobile Navigation - Visible only on mobile -->
      <div class="flex md:hidden justify-center items-center gap-4 mt-6">
        <button type="button" class="btn btn-circle btn-md bg-base-100 border-base-300 shadow-lg hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300" data-action="click->carousel#prev" aria-label="Önceki Branş">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button type="button" class="btn btn-circle btn-md bg-base-100 border-base-300 shadow-lg hover:bg-primary hover:text-primary-content hover:border-primary transition-all duration-300" data-action="click->carousel#next" aria-label="Sonraki Branş">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Kleomarcus Plus Note -->
    <p class="text-center text-base-content/90 text-xs sm:text-sm mt-8 sm:mt-10">
      <span class="badge badge-primary badge-xs sm:badge-sm mr-1.5 align-middle">Yakında</span>
      <span class="text-base-content font-display">Kleomarcus Plus</span> ile daha fazla branş, ring, kafes ve genişletilmiş CrossFit alanı.
    </p>

  </div>

</section>
