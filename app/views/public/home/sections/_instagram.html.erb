<section id="instagram" class="py-10 sm:py-14 md:py-20 bg-base-200 overflow-hidden" aria-labelledby="instagram-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-6 sm:gap-8 md:flex-row md:justify-center md:gap-12 lg:gap-20">

      <%# Phone Mockup %>
      <div class="mockup-phone border-primary scale-75 sm:scale-90 md:scale-100 -my-8 sm:-my-4 md:my-0">
        <div class="mockup-phone-camera"></div>
        <div class="mockup-phone-display">
          <%= image_tag 'public/kleomarcus-instagram.jpeg', alt: 'Kleomarcus Instagram', class: 'w-full h-full object-cover' %>
        </div>
      </div>

      <%# Content %>
      <div class="text-center md:text-left max-w-xs sm:max-w-sm">
        <p class="text-xs sm:text-sm uppercase tracking-widest text-primary font-medium mb-2">
          Instagram
        </p>
        <h2 id="instagram-title" class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-base-content mb-3 sm:mb-4">
          Bizi Takip Edin
        </h2>
        <p class="text-sm sm:text-base text-base-content/70 mb-5 sm:mb-6">
          Antrenmanlar, müsabakalar ve daha fazlası için Instagram'da bizi takip edin.
        </p>
        <%= link_to "https://instagram.com/kleomarcus", target: "_blank", rel: "noopener noreferrer", class: "btn btn-primary btn-sm sm:btn-md gap-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @kleomarcus
        <% end %>
      </div>

    </div>
  </div>
</section>
