<%# SEO Meta Tags for Homepage %>
<%= set_seo_meta(
  description: "#{club.name} — #{club.founded_in}'dan beri Çanakkale'de #{club_discipline_names.to_sentence(last_word_connector: " ve ")} eğitimleri. 7 yaş ve üzeri tüm yaş gruplarına özel programlar, deneyimli antrenör kadrosu ve modern tesislerle dövüş sporlarında fark yaratın.",
  keywords: "kleomarcus, kleomarcus spor akademi, çanakkale boks, çanakkale kick boks, çanakkale muay thai, çanakkale mma, çanakkale wushu, çanakkale crossfit, çanakkale hyrox, çanakkale bodybuilding, dövüş sporları çanakkale, dövüş kulübü çanakkale, spor salonu çanakkale, bireysel antrenman çanakkale, grup dersleri, çocuk boks çanakkale, yetişkin dövüş eğitimi, özel ders dövüş sporları",
  og_description: "#{club.name} — #{club.founded_in}'dan beri Çanakkale'de dövüş sporları ve fitness akademisi. Deneyimli antrenörler eşliğinde her yaş ve seviyeye uygun eğitim programları.",
  og_image: "public/hero-desktop.jpeg"
) %>

<%# Structured Data for SEO %>
<% content_for :structured_data do %>
  <%= structured_data_tag(organization_schema.merge("description": seo_description)) %>
<% end %>

