<%# SEO Meta Tags for Homepage %>
<%= set_seo_meta(
  title: "Çanakkale Dövüş Sporları Kulübü",
  description: "#{club_identity_sentence} #{club_offering_sentence.upcase_first}. 7 yaş ve üzeri tüm yaş gruplarına özel programlar, deneyimli antrenör kadrosu.",
  og_description: "#{club_identity_sentence} #{club_combat_names.to_sentence(last_word_connector: " ve ")} branşlarında her yaş ve seviyeye uygun eğitim programları.",
  og_image: "public/hero-desktop.jpeg"
) %>

<%# Structured Data for SEO %>
<% content_for :structured_data do %>
  <%= structured_data_tag(organization_schema.merge("description": seo_description)) %>
<% end %>

