<%# SEO Meta Tags for Swimming Application Thanks Page %>
<%= set_seo_meta(title: "Başvurunuz Alındı") %>

<section class="py-14 sm:py-16 md:py-20 lg:py-24 bg-base-100" aria-labelledby="thanks-title">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">

      <%# Success Header %>
      <div class="text-center mb-10 sm:mb-12">
        <div class="relative mx-auto mb-6 w-20 h-20 sm:w-24 sm:h-24">
          <div class="absolute inset-0 rounded-full border border-success/20"></div>
          <div class="absolute inset-2 rounded-full border border-success/30"></div>
          <div class="absolute inset-4 rounded-full bg-success/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 sm:w-9 sm:h-9 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>

        <h1 id="thanks-title" class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-base-content mb-3">
          Başvurunuz Başarıyla Alındı
        </h1>

        <div class="relative mx-auto w-32 sm:w-40 mb-5">
          <div class="h-[2px] w-full bg-gradient-to-r from-transparent via-primary to-transparent"></div>
        </div>

        <p class="max-w-xl mx-auto text-sm sm:text-base text-base-content/70 leading-relaxed">
          Yüzme başvurunuz ekibimize iletildi. Bundan sonraki süreç aşağıdaki gibi ilerleyecek;
          sizin yapmanız gereken ek bir işlem bulunmuyor.
        </p>
      </div>

      <%# Process Steps %>
      <ol class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 mb-10 sm:mb-12">
        <li class="bg-base-200 p-5 sm:p-6 text-center">
          <span class="block font-display text-2xl sm:text-3xl font-bold text-primary mb-2">01</span>
          <h2 class="font-display text-sm sm:text-base font-bold text-base-content mb-1">Değerlendirme</h2>
          <p class="text-xs sm:text-sm text-base-content/70 leading-relaxed">Başvurunuz ekibimiz tarafından görüntülenir.</p>
        </li>

        <li class="bg-base-200 p-5 sm:p-6 text-center">
          <span class="block font-display text-2xl sm:text-3xl font-bold text-primary mb-2">02</span>
          <h2 class="font-display text-sm sm:text-base font-bold text-base-content mb-1">Telefonla Bilgilendirme</h2>
          <p class="text-xs sm:text-sm text-base-content/70 leading-relaxed">Sizi arayarak kurs, seviye ve uygun saatler hakkında bilgi veririz.</p>
        </li>

        <li class="bg-base-200 p-5 sm:p-6 text-center">
          <span class="block font-display text-2xl sm:text-3xl font-bold text-primary mb-2">03</span>
          <h2 class="font-display text-sm sm:text-base font-bold text-base-content mb-1">Rezervasyon</h2>
          <p class="text-xs sm:text-sm text-base-content/70 leading-relaxed">Size uygun programı birlikte belirler, kaydınızı oluştururuz.</p>
        </li>
      </ol>

      <%# Actions %>
      <div class="text-center">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <%= link_to "Ana Sayfaya Dön", root_path, class: "btn btn-outline btn-secondary px-8" %>
        </div>
      </div>
    </div>
  </div>
</section>
